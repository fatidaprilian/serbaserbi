# ==============================================================================
# SerbaSerbi - Environment Variables Template
# ==============================================================================
# Duplicate this file to .env.local for local development:
#   cp .env.example .env.local
#
# In Vercel Production:
#   - POSTGRES_* and DATABASE_* variables are automatically injected by the Neon integration.
#   - Variables under "Application Secrets" MUST be added manually in Vercel:
#     Project Settings > Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Injected automatically by Vercel Storage / Neon Console
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

PGHOST="ep-sample-pooler.ap-southeast-1.aws.neon.tech"
PGHOST_UNPOOLED="ep-sample.ap-southeast-1.aws.neon.tech"
PGUSER="neondb_owner"
PGDATABASE="neondb"
PGPASSWORD="your-db-password"

POSTGRES_URL="postgresql://neondb_owner:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://neondb_owner:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
POSTGRES_USER="neondb_owner"
POSTGRES_HOST="ep-sample-pooler.ap-southeast-1.aws.neon.tech"
POSTGRES_PASSWORD="your-db-password"
POSTGRES_DATABASE="neondb"
POSTGRES_URL_NO_SSL="postgresql://neondb_owner:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb"
POSTGRES_PRISMA_URL="postgresql://neondb_owner:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&connect_timeout=15&sslmode=require"

# ------------------------------------------------------------------------------
# 2. Application Secrets (MUST BE CONFIGURED IN VERCEL ENVIRONMENT VARIABLES)
# ------------------------------------------------------------------------------
# JWT session encryption secret for Auth.js (generate 32+ chars e.g. via `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-32-character-random-secret-for-nextauth"
AUTH_SECRET="your-32-character-random-secret-for-nextauth"

# Canonical application URL (use http://localhost:3000 locally, or your production domain)
NEXTAUTH_URL="https://serbaserbi.faridekaaprilian.dev"

# Master key for AES-256-GCM encryption of user OpenRouter API keys in database
# Must be exactly 32 bytes (or a 64-character hex string)
APP_ENCRYPTION_KEY="serbaserbi-master-encryption-key-32b"

# Verification secret for automated daily overdue cron jobs (Vercel Cron)
CRON_SECRET="your-secure-cron-secret-token-2026"
